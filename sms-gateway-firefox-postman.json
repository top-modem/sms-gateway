{
  "info": {
    "_postman_id": "sms-gateway-firefox-api",
    "name": "SMS Gateway - 火狐狸 Platform API",
    "description": "Collection for testing the 火狐狸 (Firefox) platform integration HTTP APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Settings",
      "item": [
        {
          "name": "Get Firefox API Key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/settings/firefox-api-key",
              "host": ["{{base_url}}"],
              "path": ["api", "settings", "firefox-api-key"]
            }
          },
          "response": []
        },
        {
          "name": "Set Firefox API Key",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"{{firefox_api_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/settings/firefox-api-key",
              "host": ["{{base_url}}"],
              "path": ["api", "settings", "firefox-api-key"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Countries",
      "item": [
        {
          "name": "Get Firefox Countries",
          "request": {
