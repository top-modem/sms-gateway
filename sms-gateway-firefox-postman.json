    {
      "name": "5. Query Platform",
      "item": [
        {
          "name": "Get Wait Phone List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/firefox/wait-list",
              "host": ["{{base_url}}"],
              "path": ["api", "firefox", "wait-list"]
            }
          },
          "response": []
        },
        {
          "name": "Get Result Phone List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/firefox/result-list?country_id=eng&phone_num=7721447303&item_id={{item_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "firefox", "result-list"],
              "query": [
                {
                  "key": "country_id",
                  "value": "eng"
                },
                {
                  "key": "phone_num",
                  "value": "7721447303"
                },
                {
                  "key": "item_id",
                  "value": "{{item_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Manual SMS Upload",
      "item": [
        {
          "name": "Upload SMS Manually",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_id\": \"eng\",\n  \"phone_num\": \"7721447303\",\n  \"sms_content\": \"Your Tinder code is 426458\\ndwEzWOx6XSV\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/firefox/upload-sms",
              "host": ["{{base_url}}"],
              "path": ["api", "firefox", "upload-sms"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "basic",
